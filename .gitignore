# Secrets and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*
*.log

# Local data and generated exports
apps/api/data/*
!apps/api/data/uploads/
!apps/api/data/processed/
!apps/api/data/exports/
apps/api/data/uploads/*
apps/api/data/processed/*
apps/api/data/exports/*
!apps/api/data/uploads/.gitkeep
!apps/api/data/processed/.gitkeep
!apps/api/data/exports/.gitkeep

# Database dumps (may contain password hashes)
*.sql
!apps/api/alembic/**/*.sql

# Pytest temp dirs created when the shared Windows temp dir is unreadable
.pytest-*/

# Test-run artifacts. The suite's runtime (database, uploads) now lives under
# the system temp directory -- see the note in apps/api/tests/conftest.py -- so
# this only covers leftovers from earlier runs and ad-hoc probes.
output/

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Deployment CLI artifacts
.vercel/
.railway/

# AI workspace data (session memory, caches). Keep the directory on disk --
# it is project state managed by the tool, never source to be committed.
.workbuddy/
.workbuddy-ai/
